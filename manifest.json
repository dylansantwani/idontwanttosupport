{
    "manifest_version": 3,
    "name": "I Don't Want to Support",
    "description": "On request, selects one visible support or ad-blocker bypass option on the current page.",
    "version": "0.1.0",
    "icons": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "64": "images/icon64.png",
      "128": "images/icon128.png"
    },
    "action": {
      "default_popup": "directions.html",
      "default_icon": "icon.png"
    },
    "permissions": ["activeTab", "scripting"]
  }
